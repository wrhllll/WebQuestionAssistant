{
  "manifest_version": 3,
  "name": "网页题目助手",
  "version": "2.3.1",
  "description": "网页题目自动框选、AI 识别解答与本地 PNG/PDF 导出。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "网页题目助手",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
